{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Entry",
  "type": "object",
  "required": ["id", "label", "timestamp", "command", "exit_code", "duration_ms", "fingerprint", "output_hash", "passed", "summary", "prev_hash"],
  "properties": {
    "id": { "type": "string", "pattern": "^evt-[a-f0-9]{8}$" },
    "label": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "command": { "type": "string" },
    "exit_code": { "type": "integer", "minimum": 0 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "output_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "passed": { "type": "boolean" },
    "summary": { "type": "string", "maxLength": 500 },
    "prev_hash": { "type": ["string", "null"], "pattern": "^([a-f0-9]{64}|null)$" },
    "max_age_ms": { "type": "integer", "minimum": 0 },
    "allow_paths": { "type": "array", "items": { "type": "string" } }
  }
}