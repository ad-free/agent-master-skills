{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "skill", "setup", "input", "execution", "verification"],
  "properties": {
    "name": { "type": "string" },
    "skill": { "type": "string" },
    "version": { "type": "string" },
    "setup": {
      "type": "object",
      "properties": {
        "repo": { "type": "object" },
        "env": { "type": "object" },
        "scripts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "input": {
      "type": "object",
      "properties": {
        "prompt": { "type": "string" },
        "context": { "type": "object" },
        "files": { "type": "object" }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "phases": { "type": "array", "items": { "type": "string" } },
        "mocks": { "type": "object" },
        "timeout": { "type": "integer" }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "state": { "type": "object" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "mustExist": { "type": "boolean" },
              "schema": { "type": "string" },
              "contains": { "type": "array", "items": { "type": "string" } },
              "notContains": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["equals", "contains", "not_contains", "not_empty", "matches", "gt", "lt"] },
              "path": { "type": "string" },
              "expected": {}
            }
          }
        },
        "tokenBudget": {
          "type": "object",
          "properties": {
            "phase": { "type": "string" },
            "maxTokens": { "type": "integer" },
            "warningThreshold": { "type": "number" }
          }
        }
      }
    },
    "teardown": { "type": "object" }
  }
}
